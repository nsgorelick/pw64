#!/bin/sh
# display x-window dumps od pw users guide figures

cd /src/active/pw.manual

a=fig.${1}.xwd.Z

if [ -f "$a" ]
then
	echo "Figure found.  Sending to Display."
	zcat $a | xwud &
	sleep 2
else
	echo "ERROR: figure not found.  Valid figures are:"
	ls fig.*.xwd.Z | sed -e 's/fig\.//' | sed -e 's/\.xwd\.Z//' | \
			sort -n | adjust

fi
