struct roseplot {
    int x, y;
    int width,height;
    int nseg;               /* how many segments, currently? */
    float radial_offset;    /* whats our offset from zero? */
    Pixmap pixmap;
    Button B;
    Button *Switches;
    Button Segs;
    Button SegSize;
    Button parent;
    Button FileSel;
    Button ImageSel;
    FIMAGE *fim;
};
