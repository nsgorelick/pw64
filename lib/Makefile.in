#
# Makefile to build libXfred.a
#
CC=@CC@
RANLIB=@RANLIB@

DEFS=@DEFS@
CPPFLAGS=@CPPFLAGS@ @XINCLUDES@
CFLAGS=@CFLAGS@ -Wall -Wextra

OBJ=Button.o Slider.o VisInfo.o Joystick.o MapAndWait.o init.o AMap.o \
    List.o xgets.o chd.o toggle.o confirm.o hershey.o Composite.o \
    LB.o MB.o PB.o RB.o CB.o XB.o xf.o misc.o 3D.o

libXfred.a:	$(OBJ) Xfred.h
	@echo "*** Making Xfred library ***"
	-rm -f libXfred.a
	ar cqv libXfred.a $(OBJ)
	$(RANLIB) libXfred.a

XLIBS=@XLIBS@

panes: panes.o libXfred.a
	$(CC) -o panes panes.o libXfred.a $(XLIBS)

sampler: sampler.o libXfred.a
	$(CC) -o sampler sampler.o libXfred.a $(XLIBS)

# --- libXfred unit tests (lib/tests/) ---
TEST_DIR = tests
RUN_XFRED_TESTS = $(TEST_DIR)/run_xfred_tests
TEST_CPPFLAGS = $(CPPFLAGS) -I.
TEST_CFLAGS = $(CFLAGS) -std=c99

.PHONY: check

check: libXfred.a $(RUN_XFRED_TESTS)
	PW64_TEST_FIXTURES=$(CURDIR)/$(TEST_DIR)/fixtures $(RUN_XFRED_TESTS)

$(RUN_XFRED_TESTS): $(TEST_DIR)/test_main.o $(TEST_DIR)/test_xfred.o libXfred.a
	$(CC) $(CFLAGS) -o $@ $(TEST_DIR)/test_main.o $(TEST_DIR)/test_xfred.o libXfred.a $(XLIBS)

$(TEST_DIR)/%.o: $(TEST_DIR)/%.c $(TEST_DIR)/test.h libXfred.a
	$(CC) -c $(TEST_CPPFLAGS) $(TEST_CFLAGS) -o $@ $<

clean:
	rm -f $(OBJ) libXfred.a panes panes.o sampler sampler.o
	rm -f $(RUN_XFRED_TESTS) $(TEST_DIR)/test_main.o $(TEST_DIR)/test_xfred.o

.c.o:
	$(CC) -c $(DEFS) $(CPPFLAGS) $(CFLAGS) $<

############################################################################
# DEPENDANCIES
############################################################################
Button.o:	Button.c Xfred.h Button.h Callback.h VisInfo.h
Slider.o:	Slider.c Xfred.h Slider.h VisInfo.h
VisInfo.o:	VisInfo.c VisInfo.h
Joystick.o:	Joystick.c Xfred.h Callback.h VisInfo.h Joystick.h
MapAndWait.o:	MapAndWait.c
init.o:		init.c
AMap.o:		AMap.c Xfred.h AMap.h Callback.h VisInfo.h
List.o: 	Button.c Slider.c Button.h Slider.h List.h VisInfo.h Callback.h
hershey.o:	hershey.c hershey.h
	$(CC) -c $(DEFS) $(CPPFLAGS) $(CFLAGS) -Wno-missing-braces -o $@ hershey.c
