dnl Process this file with autoconf to produce a configure script.
AC_INIT(pw/pw.c)
AC_CONFIG_HEADER(config.h)

dnl Check for sytem type
AC_CANONICAL_SYSTEM

AC_CYGWIN
AC_EXEEXT
AC_OBJEXT

dnl Checks for programs.
AC_PROG_CC
AC_PROG_AWK
AC_PROG_INSTALL
AC_PROG_LN_S
AC_PROG_MAKE_SET
AC_PROG_RANLIB

dnl Check for AIX
AC_AIX

dnl Check for endian
AC_C_BIGENDIAN

dnl Check input arguments for XPM
AC_ARG_WITH(xpm,
[  --without-xpm           build without XPM support (default: --with-xpm)],,
with_xpm=yes)

dnl Check input arguments for ImageMagick
AC_ARG_WITH(magick,
[  --without-magick        build without ImageMagick support
                          (default: --with-magick)
                          (without ImageMagick only VICAR, ISIS, and PNM 
                          formats are supported)], ,
with_magick=yes)

dnl Check option to use internal or external specpr reader 
AC_ARG_ENABLE(specpr,
[  --disable-specpr        disables internal specpr requestor uses external
                          program \"sp\" instead. (default: --enable-specpr)],,
enable_specpr=yes)

if test "$enable_specpr" = "yes"; then
	AC_DEFINE(INTERNAL_SP)
	INSTALL_WHAT="install_pw_only"
else
	INSTALL_WHAT="install_both"
fi


dnl Enable/Disable "core" file generation
AC_ARG_ENABLE(core,
[  --enable-core           enables core file generation (default: --disable-core)],,
enable_core=no)

if test "$enable_core" = "no"; then
	AC_DEFINE(CORE)
fi


dnl Set some defaults
test "$prefix" = NONE && prefix=/usr/local
test "$exec_prefix" = NONE && exec_prefix=${prefix}

dnl Check for X path.
AC_PATH_XTRA

dnl Checks for libraries.
old_LDFLAGS="$LDFLAGS"

if test "$x_libraries" != ""
then
	LDFLAGS="$LDFLAGS -L$x_libraries"
fi

if test "$x_includes" != ""
then
	XINCLUDES=-I$x_includes
else
	XINCLUDES=''
fi

if test "$x_libraries" != ""
then
	XLIBS=-L$x_libraries
else
	XLIBS=''
fi


dnl **   N U A N C E S   **
dnl LINUX nuance:
dnl    configure establishes /usr/X11R6/include as the X_INCLUDE path
dnl    which creates problems for ImageMagick, which is located in
dnl    /usr/include/X11 (= /usr/X11R6/include/X11) instead.
dnl AIX nuance:
dnl    Enable linker on AIX to enable generating big TOCs.
case "$target" in
*-linux-gnu)  CFLAGS="$CFLAGS -I/usr/include/X11";;
*-ibm-aix4.3*)  LDFLAGS="$LDFLAGS -Wl,-b,bigtoc";;
esac


AC_CHECK_LIB(z,crc32)
AC_CHECK_LIB(m,sqrt)
AC_CHECK_LIB(X11,XOpenDisplay)
AC_CHECK_LIB(Xt,XtToolkitInitialize)
AC_CHECK_LIB(Xext,XShmPutImage)
AC_CHECK_LIB(Xm,XmCreateForm)
AC_CHECK_LIB(nsl,getnetname)
AC_CHECK_LIB(socket,socket)

if test "$with_xpm" = "yes"
then
	dnl Check if libXpm is available.

	AC_CHECK_LIB(Xpm,XpmWriteFileFromImage,have_xpm=yes,have_xpm=no)

	if test "$have_xpm" = "yes"; then
		AC_TRY_RUN([#include <xpm.h>
			int main(){ return (XpmIncludeVersion >= 30206 /* 3.2f */); }],
			AC_DEFINE(HAVE_LIBXPM),
			AC_MSG_WARN([libXpm version 3.2f or higher required.]))
	fi
fi

if test "$with_magick" = "yes"
then
	dnl Check if ImageMagick is available.

	AC_PATH_PROG(MAGICK_CONFIG,Magick-config)
	if test -n "$MAGICK_CONFIG"
	then
		MAGICK_VERSION=`$MAGICK_CONFIG --version`
		MAGICK_CPPFLAGS=`$MAGICK_CONFIG --cppflags`
		MAGICK_CFLAGS=`$MAGICK_CONFIG --cflags`
		MAGICK_LIBS=`$MAGICK_CONFIG --libs`
		MAGICK_LDFLAGS=`$MAGICK_CONFIG --ldflags`
	fi

	dnl Check if ImageMagick is of correct version
	if test "$MAGICK_VERSION" = "5.4.2"
	then
		save_CPPFLAGS="$CPPFLAGS"
		save_CFLAGS="$CFLAGS"
		save_LIBS="$LIBS"
		save_LDFLAGS="$LDFLAGS"

		dnl Linux nuance - ImageMagick include files located in
		dnl /usr/X11R6/include/X11/magick instead of /usr/X11R6/magick.
		case "$target" in
		*-linux-gnu)  CFLAGS="$CFLAGS -I/usr/X11R6/include/X11"
		esac

		CPPFLAGS="$MAGICK_CPPFLAGS $CPPFLAGS"
		CFLAGS="$MAGICK_CFLAGS $CFLAGS"
		LIBS="$MAGICK_LIBS $LIBS"
		LDFLAGS="$MAGICK_LDFLAGS $LDFLAGS"

		dnl AC_CHECK_LIB(m, sin)
		dnl AC_CHECK_LIB(z, compress)
		dnl AC_CHECK_LIB(bz2, bzopen)
		dnl AC_CHECK_LIB(png, png_info_init)
		dnl AC_CHECK_LIB(jpeg, jpeg_read_header)
		dnl AC_CHECK_LIB(tiff, TIFFOpen)

		dnl Make sure we can use libMagick to compile.
		AC_CHECK_LIB(Magick, GetMagickInfo,,[
			CPPFLAGS="$save_CPPFLAGS"
			CFLAGS="$save_CFLAGS"
			LIBS="$save_LIBS"
			LDFLAGS="$save_LDFLAGS"
		])
	else
		AC_MSG_WARN([ImageMagick version 5.4.2 required for compiling with ImageMagick])
	fi


fi


dnl Check for includes
AC_CHECK_HEADERS(values.h)

dnl Checks for header files.
AC_HEADER_DIRENT
AC_HEADER_STDC
AC_CHECK_HEADERS(fcntl.h limits.h malloc.h sys/file.h sys/time.h unistd.h)

AC_CHECK_HEADERS(magick/magick.h magick/api.h)

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_HEADER_TIME
AC_STRUCT_TM

dnl Checks for library functions.
AC_FUNC_MEMCMP
AC_TYPE_SIGNAL
AC_FUNC_VPRINTF
AC_CHECK_FUNCS(mkdir putenv select strdup strndup strspn strstr strtod strtol strtoul)
AC_CHECK_FUNCS(index rindex getdtablesize getwd usleep strtoul basename)
AC_CHECK_FUNCS(dirname bcopy bcmp bzero)

AC_SUBST(XINCLUDES)
AC_SUBST(XLIBS)
AC_SUBST(XRTINCLUDE)
AC_SUBST(XRTLIBS)

AC_SUBST(CPPFLAGS)
AC_SUBST(CFLAGS)
AC_SUBST(LDFLAGS)

AC_SUBST(INSTALL_WHAT)

AC_CONFIG_SUBDIRS(iomedley)

AC_OUTPUT(Makefile pw/Makefile sp/Makefile lib/Makefile)
